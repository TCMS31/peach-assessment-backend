# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Bundler config and locally installed gems.
/.bundle
/vendor/bundle

# Logs and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

.byebug_history

# Secrets.
/config/master.key
.env
.env.*
!.env.example

# macOS.
.DS_Store

# Local tooling and generated output that never belongs in the repository.
/project_venv/
node_modules/
/storage/*
!/storage/.keep
/coverage/
*.log
/.github/
