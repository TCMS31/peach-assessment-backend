# Copy to .env and adjust. Every variable has a working default for local
# development; none of them is required to boot against a local Postgres with
# the default socket settings.
#
# Nothing here is read automatically - there is no dotenv gem. Export these in
# your shell, or let docker-compose read the file.

# --- Database -------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=peachtakehomebackend_development
TEST_DATABASE_NAME=peachtakehomebackend_test

# Overrides everything above when set (Rails merges it over database.yml).
# DATABASE_URL=postgres://user:pass@localhost:5432/peachtakehomebackend_development

# --- Server ---------------------------------------------------------------
PORT=3000
RAILS_ENV=development
RAILS_MAX_THREADS=5

# --- CORS -----------------------------------------------------------------
# Comma-separated browser origins. Leave empty for native-only deployments:
# a React Native client sends no Origin header and does not need this.
# ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# --- Production only ------------------------------------------------------
# SECRET_KEY_BASE=          # `bin/rails secret`
# RAILS_LOG_TO_STDOUT=1
# RAILS_LOG_LEVEL=info
# RAILS_FORCE_SSL=false
# RAILS_SERVE_STATIC_FILES=
